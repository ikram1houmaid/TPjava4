package tpjava;

class Categorie {

    private static int compteur = 0;
    private final int id;
    private String libelle;
    private String code;

    public Categorie(String libelle, String code) {
        this.id = ++compteur;
        this.libelle = libelle;
        this.code = code;
    }

    public int getId() {
        return id;
    }

    public String getLibelle() {
        return libelle;
    }

    public void setLibelle(String libelle) {
        this.libelle = libelle;
    }

    public String getCode() {
        return code;
    }

    public void setCode(String code) {
        this.code = code;
    }

    @Override
    public String toString() {
        return "Categorie{id=" + id + ", libelle='" + libelle + "', code='" + code + "'}";
    }
}

class Article {

    private static int compteur = 0;
    private final int id;
    private String code;
    private String designation;
    private Categorie categorie;

    public Article(String code, String designation, Categorie categorie) {
        this.id = ++compteur;
        this.code = code;
        this.designation = designation;
        this.categorie = categorie;
    }

    public int getId() {
        return id;
    }

    public String getCode() {
        return code;
    }

    public void setCode(String code) {
        this.code = code;
    }

    public String getDesignation() {
        return designation;
    }

    public void setDesignation(String designation) {
        this.designation = designation;
    }

    public Categorie getCategorie() {
        return categorie;
    }

    public void setCategorie(Categorie categorie) {
        this.categorie = categorie;
    }

    @Override
    public String toString() {
        return "Article{id=" + id + ", code='" + code + "', designation='" + designation + "'}";
    }
}

public class Main {

    public static void main(String[] args) {

        Categorie c1 = new Categorie("Informatique", "INFO");
        Categorie c2 = new Categorie("Bureautique", "BUR");

        Categorie[] categories = {c1, c2};

        Article a1 = new Article("A01", "Ordinateur", c1);
        Article a2 = new Article("A02", "Clavier", c1);
        Article a3 = new Article("A03", "Imprimante", c2);
        Article a4 = new Article("A04", "Souris", c1);

        Article[] articles = {a1, a2, a3, a4};

        for (Categorie categorie : categories) {

            System.out.println("Categorie : " + categorie.getLibelle());

            for (Article article : articles) {

                if (article.getCategorie() == categorie) {
                    System.out.println(article);
                }
            }

            System.out.println();
        }
    }
}