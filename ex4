package tpjava;

class Auteur {

    private static int compteur = 0;
    private final int id;
    private String nom;
    private Livre[] livres;
    private int nbLivres;

    public Auteur(String nom) {
        this.id = ++compteur;
        this.nom = nom;
        livres = new Livre[5];
        nbLivres = 0;
    }

    public int getId() {
        return id;
    }

    public String getNom() {
        return nom;
    }

    public void ajouterLivre(Livre livre) {

        for (int i = 0; i < nbLivres; i++) {
            if (livres[i] == livre) {
                return;
            }
        }

        if (nbLivres == livres.length) {
            Livre[] tmp = new Livre[livres.length * 2];

            System.arraycopy(
                livres,
                0,
                tmp,
                0,
                livres.length
            );

            livres = tmp;
        }

        livres[nbLivres++] = livre;
    }

    public void afficherLivres() {

        for (int i = 0; i < nbLivres; i++) {
            System.out.println("  • " + livres[i]);
        }
    }

    public int getNbLivres() {
        return nbLivres;
    }

    @Override
    public String toString() {
        return "Auteur[id=" + id
                + ", nom=" + nom
                + ", nbLivres=" + nbLivres
                + "]";
    }
}

class Livre {

    private static int compteur = 0;
    private final int id;
    private String titre;
    private Auteur auteur;

    public Livre(String titre, Auteur auteur) {

        this.id = ++compteur;
        this.titre = titre;
        this.auteur = auteur;

        auteur.ajouterLivre(this);
    }

    public int getId() {
        return id;
    }

    public String getTitre() {
        return titre;
    }

    public Auteur getAuteur() {
        return auteur;
    }

    @Override
    public String toString() {
        return "Livre[id=" + id
                + ", titre=" + titre
                + ", auteur=" + auteur.getNom()
                + "]";
    }
}

class Bibliotheque {

    private static int compteur = 0;
    private final int id;
    private String nom;
    private Livre[] collection;
    private int nbLivres;

    public Bibliotheque(String nom) {

        this.id = ++compteur;
        this.nom = nom;
        collection = new Livre[5];
        nbLivres = 0;
    }

    public int getId() {
        return id;
    }

    public String getNom() {
        return nom;
    }

    public void ajouterLivre(Livre livre) {

        for (int i = 0; i < nbLivres; i++) {
            if (collection[i] == livre) {
                return;
            }
        }

        if (nbLivres == collection.length) {

            Livre[] tmp = new Livre[collection.length * 2];

            System.arraycopy(
                collection,
                0,
                tmp,
                0,
                collection.length
            );

            collection = tmp;
        }

        collection[nbLivres++] = livre;
    }

    public void afficherCollection() {

        for (int i = 0; i < nbLivres; i++) {

            Livre livre = collection[i];

            System.out.println(
                "  – " +
                livre.getTitre() +
                " (id=" +
                livre.getId() +
                ")"
            );
        }
    }

    @Override
    public String toString() {

        return "Bibliotheque[id=" + id
                + ", nom=" + nom
                + ", taille=" + nbLivres
                + "]";
    }
}

public class Main {

    public static void main(String[] args) {

        Auteur hugo = new Auteur("Victor Hugo");
        Auteur orwell = new Auteur("George Orwell");

        Livre m1 = new Livre(
            "Les Misérables",
            hugo
        );

        Livre ndp = new Livre(
            "Notre-Dame de Paris",
            hugo
        );

        Livre l1984 = new Livre(
            "1984",
            orwell
        );

        Bibliotheque centrale =
            new Bibliotheque("Centrale");

        Bibliotheque quartier =
            new Bibliotheque("Quartier");

        centrale.ajouterLivre(m1);
        centrale.ajouterLivre(l1984);

        quartier.ajouterLivre(m1);
        quartier.ajouterLivre(ndp);

        System.out.println(hugo);
        hugo.afficherLivres();

        System.out.println();

        System.out.println(orwell);
        orwell.afficherLivres();

        System.out.println();

        System.out.println(centrale);
        centrale.afficherCollection();

        System.out.println();

        System.out.println(quartier);
        quartier.afficherCollection();
    }
}